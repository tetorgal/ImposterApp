{
  "extends": "expo/tsconfig.base",
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "uniwind-env.d.ts"],
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components": ["./components"],
      "@components/*": ["./components/*"],
      "@lib": ["./lib"],
      "@lib/*": ["./lib/*"],
      "@assets": ["./assets"],
      "@assets/*": ["./assets/*"],
      "@screens": ["./app"],
      "@screens/*": ["./app/*"],
      "@/*": ["./*"]
    },
    "types": ["node"]
  }
}
