{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "quality": "pnpm lint && pnpm typecheck && pnpm format:check",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/google-sans": "0.4.0",
    "@expo/metro-runtime": "~57.0.15",
    "@gorhom/bottom-sheet": "^5.2.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "convex": "^1.36.1",
    "dotenv": "^17.4.2",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "5.0.15",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "heroui-native": "^1.0.2",
    "lucide-react-native": "^1.14.0",
    "metro-source-map": "0.80.5",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.74.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "toggle-switch-react-native": "^3.3.0",
    "uniwind": "^1.6.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "10.10.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "4.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "18.*.*",
      "react-native": ">=0.76.7 <1.0.0"
    }
  },
  "main": "expo-router/entry",
  "private": true
}